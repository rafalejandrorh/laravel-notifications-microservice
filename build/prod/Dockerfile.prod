FROM php:8.4-fpm

# Extensiones de sistema necesarias para PHP, Laravel, MongoDB y AMQP
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        zlib1g-dev \
        g++ \
        git \
        libpng-dev \
        libicu-dev \
        libzip-dev \
        libsqlite3-dev \
        libssl-dev \
        librabbitmq-dev \
        pkg-config \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# Extensiones de PHP
RUN docker-php-ext-install \
        intl \
        opcache \
        pdo \
        pdo_sqlite \
        zip \
        bcmath \
        gd \
        pcntl

# APCu, MongoDB y AMQP
RUN pecl install apcu mongodb amqp \
    && docker-php-ext-enable apcu mongodb amqp

# Configuración de PHP y Opcache para producción
COPY build/prod/php-prod.ini /usr/local/etc/php/conf.d/php-prod.ini
COPY build/prod/opcache-prod.ini /usr/local/etc/php/conf.d/opcache-prod.ini

# Composer (requerido antes de composer install)
RUN curl -sS https://getcomposer.org/installer | php -- \
    --install-dir=/usr/local/bin --filename=composer

WORKDIR /var/www/html

# Dependencias primero (mejor cache de capas)
COPY composer.json composer.lock* ./
RUN composer install --no-dev --no-autoloader --no-interaction --no-progress --no-scripts

# Código de la aplicación
COPY . .
RUN composer dump-autoload -o \
    && php artisan package:discover --ansi || true

# Entrypoint de producción
COPY build/prod/entrypoint.prod.sh /usr/local/bin/entrypoint-prod.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint-prod.sh \
    && chmod +x /usr/local/bin/entrypoint-prod.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-prod.sh"]
